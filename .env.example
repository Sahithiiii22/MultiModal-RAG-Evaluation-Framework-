# RAG Selection & Benchmarking Framework Configuration
APP_NAME="Unified Multimodal RAG Evaluation & Selection Framework"
VERSION="1.0.0"

# Provider Settings: "groq", "gemini", "openai", "anthropic", "ollama", "demo"
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=all-MiniLM-L6-v2

# API Keys (Provide your respective provider key)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Retrieval Parameters
VECTOR_DB=chroma
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50
